# Public DeSo node used for login, profiles, and posts.
NEXT_PUBLIC_DESO_NODE_URI=https://node.deso.org

# Optional server-side override for the same node.
DESO_NODE_URI=https://node.deso.org

# X (Twitter) OAuth 2.0. Leave blank to hide Connect X.
# In the X developer portal, set the callback to X_REDIRECT_URI.
# X rejects http://localhost — use http://127.0.0.1:3000 while developing.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/api/x/callback
# At least 16 characters. Encrypts the X session cookie.
X_TOKEN_SECRET=
